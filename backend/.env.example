# Copy this file to `.env` (in the project root) before running docker compose up.
# Values here are for local dev only — never commit real secrets.

# Active Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080

# Database (matches docker-compose postgres service)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=skybooker
DB_USER=skybooker
DB_PASSWORD=skybooker

# JWT — MUST be at least 32 bytes (256 bits) for HS256
JWT_SECRET=docker-dev-secret-please-override-in-prod-at-least-32-bytes-1234567890

# Frontend allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
