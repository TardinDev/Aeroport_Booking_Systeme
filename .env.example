# Copy this file to `.env` before running `docker compose up`.
# Values below are safe defaults for local dev only — never commit real secrets.

# Active Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Port mappings
SERVER_PORT=8080
DB_PORT=5432

# Database
DB_NAME=skybooker
DB_USER=skybooker
DB_PASSWORD=skybooker

# JWT — MUST be at least 32 bytes (256 bits) for HS256.
# Generate a real one with:  openssl rand -base64 48
JWT_SECRET=docker-dev-secret-please-override-in-prod-at-least-32-bytes-1234567890

# Comma-separated list of origins allowed by the API CORS config
CORS_ORIGINS=http://localhost:5173
